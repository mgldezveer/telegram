# ============================================
# AI Content Bot Configuration
# ============================================

# --------------------------------------------
# Bot Configuration (Required)
# --------------------------------------------
TELEGRAM_BOT_TOKEN=8282443190:AAEwDcfQjNuu0M46pxyqB2pl5_7NsWJvOpg
ADMIN_IDS=123456789,987654321

# --------------------------------------------
# LLM Provider Configuration
# --------------------------------------------

# === Groq Provider (Recommended - Fast & Free) ===
# Get API key from: https://console.groq.com/keys
LLM_GROQ_ENABLED=true
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
LLM_GROQ_PRIORITY=1

# === Google Gemini Provider (High Quality) ===
# Get API key from: https://makersuite.google.com/app/apikey
LLM_GEMINI_ENABLED=true
GEMINI_API_KEY=AIzaSyBMRjCHPYpJlA6p8kPK-qbotkaIcvRMuPQ
GEMINI_MODEL=gemini-1.5-flash
LLM_GEMINI_PRIORITY=2

# === Hugging Face Provider (Fallback) ===
# Get API key from: https://huggingface.co/settings/tokens (optional)
LLM_HUGGINGFACE_ENABLED=true
HUGGINGFACE_API_KEY=your_huggingface_token_here
HUGGINGFACE_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1
LLM_HUGGINGFACE_PRIORITY=3

# --------------------------------------------
# LLM System Configuration
# --------------------------------------------

# Enable response caching (reduces API calls by 30%+)
LLM_ENABLE_CACHE=true
LLM_CACHE_TTL=3600
LLM_CACHE_MAX_SIZE=1000

# Use Redis for caching (falls back to memory if unavailable)
LLM_USE_REDIS=true

# Enable rate limiting
LLM_RATE_LIMIT_ENABLED=true

# Retry configuration
LLM_MAX_RETRIES=3

# Default generation parameters
LLM_DEFAULT_MAX_TOKENS=1000
LLM_DEFAULT_TEMPERATURE=0.7

# --------------------------------------------
# Database Configuration (Optional)
# --------------------------------------------
# Database URL (default: sqlite:///bot.db)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_content_bot

# Connection pool size (default: 10)
DB_POOL_SIZE=10

# Echo SQL queries to logs (default: false)
DB_ECHO=false

# --------------------------------------------
# Redis Configuration (Optional - Recommended for production)
# --------------------------------------------
# Redis is used for caching LLM responses and session management
# If Redis is unavailable, the bot automatically falls back to in-memory caching
# See docs/REDIS_SETUP.md for installation instructions

# Redis connection URL (required if using Redis)
# Format: redis://[password@]host[:port][/database]
# Examples:
#   redis://localhost:6379/0              - Local Redis, no password
#   redis://:mypassword@localhost:6379/0  - With password
#   rediss://secure.redis.com:6380/0      - SSL/TLS connection
REDIS_URL=redis://localhost:6379/0

# Maximum connections in pool (default: 10)
REDIS_MAX_CONNECTIONS=10

# Socket timeout in seconds (default: 5)
REDIS_SOCKET_TIMEOUT=5

# Connection timeout in seconds (default: 5)
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Retry on timeout (default: true)
REDIS_RETRY_ON_TIMEOUT=true

# Health check interval in seconds (default: 30)
REDIS_HEALTH_CHECK_INTERVAL=30

# Optional: Redis password (if required)
# REDIS_PASSWORD=your_redis_password

# Optional: Redis database number 0-15 (default: 0)
# REDIS_DB=0

# --------------------------------------------
# Cache Configuration
# --------------------------------------------
# Enable fallback to memory cache when Redis unavailable (default: true)
CACHE_FALLBACK_ENABLED=true

# Memory cache max size (default: 1000 entries)
CACHE_MEMORY_MAX_SIZE=1000

# Default cache TTL in seconds (default: 300)
CACHE_DEFAULT_TTL=300

# LLM response caching
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL=3600
LLM_CACHE_MAX_SIZE=1000

# --------------------------------------------
# Scheduling Configuration (Optional)
# --------------------------------------------
# Default posting frequency in posts per day (default: 3)
DEFAULT_POSTING_FREQUENCY=3

# Timezone for scheduling (default: UTC)
TIMEZONE=UTC

# --------------------------------------------
# Webhook Configuration (Optional - for production)
# --------------------------------------------
# Webhook URL for receiving updates
# WEBHOOK_URL=https://yourdomain.com

# --------------------------------------------
# Monitoring Configuration (Optional)
# --------------------------------------------
# Monitoring server port for Prometheus metrics and health checks (default: 9090)
MONITORING_PORT=9090

# Health check endpoint: http://localhost:9090/health
# Metrics endpoint: http://localhost:9090/metrics

# --------------------------------------------
# Python Version Configuration (Optional)
# --------------------------------------------
# Minimum Python version check (default: enabled)
PYTHON_VERSION_CHECK_ENABLED=true

# Minimum required Python version (default: 3.10)
PYTHON_MIN_VERSION=3.10

# --------------------------------------------
# Telethon Configuration (For Real Channel Statistics)
# --------------------------------------------
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Session name for Telethon (default: bot_stats)
TELETHON_SESSION_NAME=bot_stats

# --------------------------------------------
# Social Media API Configuration (Optional)
# --------------------------------------------
# Twitter API Configuration
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here

# Facebook API Configuration
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here

# Instagram API Configuration
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

# LinkedIn API Configuration
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_ORGANIZATION_ID=your_linkedin_organization_id_here

# --------------------------------------------
# Logging Configuration (Optional)
# --------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# Debug mode: true or false (default: false)
DEBUG=false
