# ============================================
# AI Content Bot Configuration
# ============================================

# --------------------------------------------
# Bot Configuration (Required)
# --------------------------------------------
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

# --------------------------------------------
# AI Provider (Required - choose one)
# --------------------------------------------
# For Groq (recommended - free tier available)
GROQ_API_KEY=your_groq_api_key

# OR for OpenAI
# OPENAI_API_KEY=your_openai_api_key

# --------------------------------------------
# AI Model Configuration (Optional)
# --------------------------------------------
# Model name (default: qwen-2.5-72b-instruct for Groq, gpt-4 for OpenAI)
AI_MODEL=qwen-2.5-72b-instruct

# Temperature: controls randomness (0.0-2.0, default: 0.7)
# Lower = more focused, Higher = more creative
AI_TEMPERATURE=0.7

# Maximum tokens in response (default: 1000)
AI_MAX_TOKENS=1000

# --------------------------------------------
# Database Configuration (Optional)
# --------------------------------------------
# Database URL (default: sqlite:///bot.db)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_content_bot

# Connection pool size (default: 10)
DB_POOL_SIZE=10

# Echo SQL queries to logs (default: false)
DB_ECHO=false

# --------------------------------------------
# Redis Configuration (Optional)
# --------------------------------------------
# Redis URL (default: redis://localhost:6379/0)
REDIS_URL=redis://localhost:6379/0

# Maximum Redis connections (default: 50)
REDIS_MAX_CONNECTIONS=50

# --------------------------------------------
# Scheduling Configuration (Optional)
# --------------------------------------------
# Default posting frequency in posts per day (default: 3)
DEFAULT_POSTING_FREQUENCY=3

# Timezone for scheduling (default: UTC)
TIMEZONE=UTC

# --------------------------------------------
# Webhook Configuration (Optional - for production)
# --------------------------------------------
# Webhook URL for receiving updates
# WEBHOOK_URL=https://yourdomain.com

# --------------------------------------------
# Logging Configuration (Optional)
# --------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# Debug mode: true or false (default: false)
DEBUG=false
