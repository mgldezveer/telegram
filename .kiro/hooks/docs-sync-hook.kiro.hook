{
  "enabled": true,
  "name": "Documentation Sync",
  "description": "Monitors source file changes (Python files based on the steering documents context) and prompts the agent to update relevant documentation in README or /docs folder to keep documentation in sync with code changes",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.py",
      "*.md",
      "requirements.txt",
      "docker-compose.yml",
      "Dockerfile",
      ".env.example"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Source files have been modified. Please review the changes and update the documentation accordingly:\n\n1. Check if README.md needs updates for:\n   - Installation instructions\n   - Configuration changes\n   - New features or commands\n   - Usage examples\n   - API changes\n\n2. If a /docs folder exists, update relevant documentation files there\n\n3. Ensure documentation accurately reflects the current codebase\n\n4. Update any code examples in documentation to match current implementation\n\nPlease analyze the file changes and update the appropriate documentation files."
  }
}